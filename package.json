{
  "name": "personalaity",
  "version": "0.5.0",
  "description": "An open specification for AI personality. Define it once, render it anywhere — HEXACO facets, Schwartz values, PAD dynamics, compiled to any medium and measurable.",
  "type": "module",
  "bin": {
    "personalaity": "./bin/personalaity.js",
    "personalaity-mcp": "./bin/personalaity-mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "personas/",
    "SPEC.md"
  ],
  "scripts": {
    "test": "node test/smoke.js && node test/eval-smoke.js && node --test test/unit.test.js test/schema.test.js test/golden.test.js test/mcp.test.js test/battery.test.js",
    "test:update-golden": "UPDATE_GOLDEN=1 node --test test/golden.test.js",
    "build:demo": "node scripts/build-demo-personas.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0 <1.0.0"
  },
  "author": "Gianmarco Pinto",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gianmarco-pinto/personalAIty.git"
  },
  "homepage": "https://personalaity.dev",
  "bugs": {
    "url": "https://github.com/gianmarco-pinto/personalAIty/issues"
  },
  "keywords": [
    "ai",
    "personality",
    "persona",
    "hexaco",
    "llm",
    "system-prompt",
    "character",
    "psychometrics",
    "open-standard",
    "sycophancy"
  ],
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
